{
  "name": "Category",
  "type": "object",
  "properties": {
    "slug": {
      "type": "string",
      "description": "Identificador \u00fanico da categoria (ex: politica, esportes)"
    },
    "label": {
      "type": "string",
      "description": "Nome de exibi\u00e7\u00e3o da categoria"
    },
    "color": {
      "type": "string",
      "description": "Cor s\u00f3lida hexadecimal (ex: #D71E1F)"
    },
    "gradient_start": {
      "type": "string",
      "description": "Cor inicial do gradiente (hex)"
    },
    "gradient_end": {
      "type": "string",
      "description": "Cor final do gradiente (hex)"
    },
    "group": {
      "type": "string",
      "enum": [
        "news",
        "tech",
        "entertainment",
        "lifestyle",
        "health",
        "local",
        "policia",
        "outros"
      ],
      "default": "outros",
      "description": "Grupo da categoria para organiza\u00e7\u00e3o"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Categoria ativa"
    }
  },
  "required": [
    "slug",
    "label",
    "color"
  ]
}