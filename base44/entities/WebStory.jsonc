{
  "name": "WebStory",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "maxLength": 60,
      "description": "T\u00edtulo do story (m\u00e1x 60 caracteres)"
    },
    "category": {
      "type": "string",
      "enum": [
        "politica",
        "economia",
        "esportes",
        "entretenimento",
        "tecnologia",
        "saude",
        "educacao",
        "mundo",
        "brasil",
        "local",
        "cidade",
        "turismo",
        "transporte",
        "musica",
        "ciencia"
      ],
      "description": "Categoria do story"
    },
    "media_url": {
      "type": "string",
      "description": "URL da imagem ou v\u00eddeo vertical (9:16)"
    },
    "media_type": {
      "type": "string",
      "enum": [
        "image",
        "video"
      ],
      "default": "image",
      "description": "Tipo de m\u00eddia"
    },
    "external_link": {
      "type": "string",
      "description": "Link de destino ao clicar no story"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published"
      ],
      "default": "draft",
      "description": "Status de publica\u00e7\u00e3o"
    },
    "views_count": {
      "type": "number",
      "default": 0,
      "description": "Contador de visualiza\u00e7\u00f5es"
    }
  },
  "required": [
    "title",
    "category",
    "media_url",
    "status"
  ]
}