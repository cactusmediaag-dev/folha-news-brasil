{
  "name": "Alerta",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "T\u00edtulo completo do alerta/not\u00edcia"
    },
    "type": {
      "type": "string",
      "enum": [
        "alerta",
        "ao_vivo",
        "urgente"
      ],
      "default": "alerta",
      "description": "Tipo do alerta"
    },
    "post_url": {
      "type": "string",
      "description": "URL ou slug da not\u00edcia relacionada (opcional)"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora de expira\u00e7\u00e3o do alerta"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Alerta ativo"
    }
  },
  "required": [
    "title",
    "type"
  ]
}