{
  "name": "TeamMember",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome completo do membro"
    },
    "email": {
      "type": "string",
      "description": "Email do membro"
    },
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "editor",
        "jornalista"
      ],
      "default": "jornalista",
      "description": "Fun\u00e7\u00e3o na equipe"
    },
    "avatar_url": {
      "type": "string",
      "description": "URL da foto do perfil"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Membro ativo"
    }
  },
  "required": [
    "name",
    "email",
    "role"
  ]
}